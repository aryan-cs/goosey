SETTLEMENT_WORKER_STALE_AFTER_MS="30000"
EXPIRED_MARKET_READY_LAG_MS="120000"
SETTLEMENT_RUN_READY_LAG_MS="120000"

# Signup is usable immediately. Set true only to explicitly require verified email.
REQUIRE_EMAIL_VERIFICATION="false"

# Optional read-only chain preflight; current website remains database-backed.
# Explicit localnet/devnet only. Never use real-value assets or mainnet keys.
GOOSEY_SOLANA_CLUSTER=""
GOOSEY_SOLANA_RPC_URL=""
GOOSEY_SOLANA_PROGRAM_ID=""
GOOSEY_SOLANA_GENESIS_HASH=""

# Server-only app-managed custody. Generate the encryption key with
# `openssl rand -base64 32`, convert/store it as unpadded base64url in the
# deployment secret manager, and assign a stable non-secret key identifier.
# Never prefix either variable with NEXT_PUBLIC_.
GOOSEY_SOLANA_CUSTODY_ENCRYPTION_KEY=""
GOOSEY_SOLANA_CUSTODY_KEY_ID=""

# Server-only localnet/devnet fee sponsor. The secret is the canonical base64
# encoding of the Solana 64-byte secret key. Never prefix either with NEXT_PUBLIC_.
GOOSEY_SOLANA_SPONSOR_ADDRESS=""
GOOSEY_SOLANA_SPONSOR_SECRET_KEY=""
GOOSEY_SOLANA_ENROLLMENT_AUTHORITY_ADDRESS=""
GOOSEY_SOLANA_ENROLLMENT_AUTHORITY_SECRET_KEY=""
GOOSEY_SOLANA_IDENTITY_DIGEST_SECRET=""
GOOSEY_SOLANA_USER_FEATHER_ALLOWANCE="1000000"
GOOSEY_SOLANA_ENROLLMENT_EXPIRES_AT="2147483647"
GOOSEY_SOLANA_SETTLEMENT_ATTESTATION_ENABLED="false"
# Public deployment-domain digest configured in the Goosey program's database
# settlement attestation config. Generate 32 random bytes and encode lowercase hex.
GOOSEY_SOLANA_DATABASE_DOMAIN=""
GOOSEY_SOLANA_SETTLEMENT_ATTESTATION_AUTHORITY_ADDRESS=""
GOOSEY_SOLANA_SETTLEMENT_ATTESTATION_AUTHORITY_SECRET_KEY=""
