generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@goosey/postgresql-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_DATABASE_URL")
  directUrl = env("POSTGRES_DIRECT_DATABASE_URL")
}

model User {
  id                            String                         @id @default(cuid())
  email                         String                         @unique
  username                      String                         @unique
  displayName                   String
  passwordHash                  String
  emailVerifiedAt               DateTime?                      @db.Timestamptz(3)
  role                          String                         @default("USER")
  status                        String                         @default("ACTIVE")
  bio                           String                         @default("")
  profilePublic                 Boolean                        @default(false)
  leaderboardVisible            Boolean                        @default(false)
  notificationPreferences       String                         @default("{}")
  balanceMilli                  BigInt                         @default(0)
  realizedPnlMilli              BigInt                         @default(0)
  createdAt                     DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime                       @updatedAt @db.Timestamptz(3)
  lastActiveAt                  DateTime                       @default(now()) @db.Timestamptz(3)
  sessions                      Session[]
  accountTokens                 AccountToken[]
  createdMarkets                Market[]                       @relation("MarketCreator")
  createdEvents                 MarketEvent[]                  @relation("MarketEventCreator")
  eventCreationRequests         MarketEventCreationRequest[]   @relation("MarketEventCreationActor")
  positions                     Position[]
  trades                        Trade[]
  journalEntries                JournalEntry[]                 @relation("JournalActor")
  comments                      Comment[]
  watchlist                     WatchlistEntry[]
  suggestions                   MarketSuggestion[]             @relation("SuggestionAuthor")
  reviewedSuggestions           MarketSuggestion[]             @relation("SuggestionReviewer")
  resolutionProposals           MarketResolutionProposal[]     @relation("ResolutionProposer")
  approvedResolutions           MarketResolutionProposal[]     @relation("ResolutionApprover")
  approvedSettlementRuns        MarketSettlementRun[]          @relation("SettlementRunApprover")
  createdInvites                RegistrationInvite[]           @relation("InviteCreator")
  inviteClaim                   RegistrationInviteClaim?
  registrationDevices           RegistrationDevice[]
  auditLogs                     AuditLog[]                     @relation("AuditActor")
  notifications                 Notification[]
  reportsMade                   CommentReport[]                @relation("ReportAuthor")
  reportsResolved               CommentReport[]                @relation("ReportResolver")
  marketOrders                  MarketOrder[]
  orderEvents                   OrderEvent[]
  orderCommands                 OrderCommand[]
  orderReservations             OrderReservation[]
  solanaWalletChallenges        SolanaWalletLinkChallenge[]
  solanaWalletLinks             SolanaWalletLink[]
  solanaCustodyIdentities       SolanaCustodyIdentity[]
  solanaProvisioningCheckpoints SolanaProvisioningCheckpoint[]

  @@index([role, status])
  @@index([balanceMilli])
}

model AccountToken {
  id         String    @id @default(cuid())
  userId     String
  purpose    String
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([purpose, expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  userAgent String?
  ipHash    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SolanaWalletLinkChallenge {
  id            String    @id
  userId        String
  /// Immutable binding value; intentionally not a foreign key so session rotation cannot erase a consumed nonce tombstone.
  sessionId     String
  purpose       String    @default("LINK_WALLET")
  origin        String
  domain        String
  uri           String
  chainId       String
  genesisHash   String
  walletAddress String
  nonceHash     String    @unique
  messageHash   String
  issuedAt      DateTime  @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sessionId, consumedAt])
  @@index([expiresAt])
}

model SolanaWalletLink {
  id            String   @id @default(cuid())
  userId        String
  chainId       String
  genesisHash   String
  walletAddress String
  verifiedAt    DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chainId, genesisHash, walletAddress])
  @@unique([userId, chainId, genesisHash])
  @@index([userId])
}

/// App-managed, non-exportable Solana identity for invisible localnet/devnet settlement.
/// encryptedSecretKey is AES-256-GCM ciphertext; key material is never exposed by DTOs.
model SolanaCustodyIdentity {
  id                  String   @id @default(cuid())
  userId              String
  chainId             String
  genesisHash         String
  walletAddress       String
  encryptionAlgorithm String   @default("AES-256-GCM")
  keyVersion          Int      @default(1)
  keyId               String
  encryptedSecretKey  String
  encryptionNonce     String
  encryptionAuthTag   String
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chainId, genesisHash], map: "SolanaCustody_user_domain_key")
  @@unique([chainId, genesisHash, walletAddress], map: "SolanaCustody_domain_wallet_key")
  @@index([userId])
}

/// Resumable server-side enrollment/claim checkpoint. Signed wire bytes are
/// public transaction material, never custody secrets. revision is a CAS fence.
model SolanaProvisioningCheckpoint {
  id             String   @id @default(cuid())
  userId         String
  chainId        String
  genesisHash    String
  revision       Int      @default(0)
  checkpointJson String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chainId, genesisHash], map: "SolanaProvisioningCheckpoint_scope_key")
  @@index([userId], map: "SolanaProvisioningCheckpoint_user_idx")
}

/// One durable serialization lane for every deployment, wallet, and market.
/// Automatic seat, funding, and order mutations must hold its fenced lease.
model SolanaChainMutationLane {
  id                String    @id @default(cuid())
  genesisHash       String
  programAddress    String
  walletAddress     String
  chainMarketId     String
  revision          Int       @default(0)
  leaseOwner        String?
  leaseTokenHash    String?
  leaseEpoch        Int       @default(0)
  leaseExpiresAt    DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([genesisHash, programAddress, walletAddress, chainMarketId], map: "SolanaMutationLane_identity_key")
  @@index([leaseExpiresAt], map: "SolanaMutationLane_expiry_idx")
}

/// Durable application intent for one sponsored Solana operation. Deployment and
/// request identity are immutable; workers mutate execution state only with a
/// revision CAS and a hashed lease fence.
model ChainCommand {
  id                    String                       @id @default(cuid())
  cluster               String
  genesisHash           String
  programAddress        String
  scope                 String
  scopeId               String
  actorId               String
  operation             String
  idempotencyKey        String
  requestHash           String
  /// Canonical JSON whose SHA-256 is requestHash.
  requestJson           String
  status                String                       @default("ACCEPTED")
  revision              Int                          @default(0)
  leaseOwner            String?
  leaseTokenHash        String?
  leaseEpoch            Int                          @default(0)
  leaseExpiresAt        DateTime?                    @db.Timestamptz(3)
  attemptCount          Int                          @default(0)
  lastErrorCode         String?
  lastErrorMessage      String?
  acceptedAt            DateTime                     @default(now()) @db.Timestamptz(3)
  preparedAt            DateTime?                    @db.Timestamptz(3)
  signedAt              DateTime?                    @db.Timestamptz(3)
  submittedAt           DateTime?                    @db.Timestamptz(3)
  confirmedAt           DateTime?                    @db.Timestamptz(3)
  finalizedAt           DateTime?                    @db.Timestamptz(3)
  projectedAt           DateTime?                    @db.Timestamptz(3)
  unknownSince          DateTime?                    @db.Timestamptz(3)
  createdAt             DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                     @updatedAt @db.Timestamptz(3)
  signedWireJournal     ChainCommandSignedWire[]
  settlementAttestation MarketSettlementAttestation?

  @@unique([genesisHash, programAddress, scope, scopeId, operation, idempotencyKey], map: "ChainCommand_scoped_idempotency_key")
  @@index([status, leaseExpiresAt], map: "ChainCommand_dispatch_idx")
  @@index([genesisHash, programAddress, status], map: "ChainCommand_deployment_status_idx")
}

/// Append-only exact signed transaction bytes and the metadata needed to prove
/// which wire payload was submitted. Retries append; they never rewrite history.
model ChainCommandSignedWire {
  id                   String       @id @default(cuid())
  commandId            String
  sequence             Int
  leaseEpoch           Int
  commandRevision      Int
  wireVersion          String
  signedWireBase64     String
  signedWireByteLength Int
  signedWireSha256     String
  transactionSignature String       @unique
  recentBlockhash      String
  lastValidBlockHeight BigInt?
  durableNonceAddress  String?
  feePayerAddress      String
  signerAddressesJson  String
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  command              ChainCommand @relation(fields: [commandId], references: [id], onDelete: Restrict)

  @@unique([commandId, sequence], map: "ChainCommandWire_command_sequence_key")
  @@index([commandId, createdAt], map: "ChainCommandWire_command_created_idx")
}

/// Durable membership of a signature in one frozen ingestion window; retained after completion.
model SolanaIngestionVisit {
  id                String   @id @default(cuid())
  genesisHash       String
  programAddress    String
  scanHeadSignature String
  signature         String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@unique([genesisHash, programAddress, scanHeadSignature, signature], map: "SolanaVisit_domain_scan_signature_key")
}

/// Finalized discovery progress only; never a financial source of truth.
/// Commit head only after the fixed scan window reaches its previous anchor.
/// coverageStartSignature is the explicit inclusive backfill boundary, not proof of genesis coverage.
model SolanaIngestionCursor {
  id                     String   @id @default(cuid())
  genesisHash            String
  programAddress         String
  committedHeadSignature String?
  scanHeadSignature      String?
  scanBeforeSignature    String?
  coverageStartSignature String
  backfillComplete       Boolean  @default(false)
  revision               Int      @default(0)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)

  @@unique([genesisHash, programAddress], map: "SolanaCursor_domain_key")
}

/// Immutable operator evidence for an explicit localnet-only coverage boundary rotation.
/// Database triggers reject UPDATE and DELETE so prior cursor state cannot be rewritten.
model SolanaCoverageRotation {
  id                             String   @id
  genesisHash                    String
  programAddress                 String
  previousCoverageStartSignature String
  previousCommittedHeadSignature String?
  previousScanHeadSignature      String?
  previousScanBeforeSignature    String?
  previousBackfillComplete       Boolean
  previousRevision               Int
  previousCursorCreatedAt        DateTime @db.Timestamptz(3)
  previousCursorUpdatedAt        DateTime @db.Timestamptz(3)
  previousCursorSha256           String
  newCoverageStartSignature      String
  newBoundarySlot                BigInt
  newBoundaryConfigurationSlot   BigInt
  newBoundaryEventKey            String
  newBoundaryWalletAddress       String
  newBoundaryEnrollmentAddress   String
  reason                         String
  createdAt                      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([genesisHash, programAddress, previousRevision], map: "SolanaRotation_domain_revision_key")
  @@index([genesisHash, programAddress, createdAt], map: "SolanaRotation_domain_created_idx")
}

/// Application validates status: PENDING, BLOCKED, VERIFIED_SUCCESS, VERIFIED_FAILED, VERIFIED_NOT_INVOKED.
/// VERIFIED_SUCCESS with eventCount=0 is a durable receipt, not missing work.
model SolanaTransactionReceipt {
  id                String               @id @default(cuid())
  genesisHash       String
  programAddress    String
  signature         String
  /// Store contract: 0 <= slot <= 9223372036854775807; validate bigint before every write.
  slot              BigInt
  status            String               @default("PENDING")
  eventCount        Int                  @default(0)
  decoderVersion    Int                  @default(1)
  /// Same signed-range contract as slot; current validation context, not historical execution state.
  configurationSlot BigInt?
  lastError         String?
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  events            SolanaProgramEvent[]

  @@unique([genesisHash, programAddress, signature], map: "SolanaReceipt_domain_signature_key")
  @@index([genesisHash, programAddress, slot], map: "SolanaReceipt_domain_slot_idx")
}

/// Append-only application contract; replay compares exact payloads plus metadata and receipt eventCount.
/// No relations to application users, markets, balances, or ledger accounts.
model SolanaProgramEvent {
  /// genesisHash:programAddress:signature:logIndex from the validated decoder.
  eventKey        String                   @id
  receiptId       String
  logIndex        Int
  invocationDepth Int
  kind            String
  /// Canonical JSON; all on-chain bigint values are decimal strings (including full u64).
  payload         String
  schemaVersion   Int                      @default(1)
  marketAddress   String?
  walletAddress   String?
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  receipt         SolanaTransactionReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@unique([receiptId, logIndex])
  @@index([marketAddress, receiptId])
}

model Market {
  id                  String                     @id @default(cuid())
  /// Immutable financial namespace. SQL migrations enforce backend/collateral consistency.
  executionBackend    String                     @default("DATABASE")
  slug                String                     @unique
  title               String
  shortTitle          String
  description         String
  rules               String
  resolutionSource    String
  category            String
  status              String                     @default("OPEN")
  resolution          String?
  featured            Boolean                    @default(false)
  color               String                     @default("gold")
  icon                String                     @default("sparkles")
  closesAt            DateTime                   @db.Timestamptz(3)
  resolvesAt          DateTime                   @db.Timestamptz(3)
  resolvedAt          DateTime?                  @db.Timestamptz(3)
  yesShares           Int                        @default(0)
  noShares            Int                        @default(0)
  liquidityParameter  Int                        @default(40)
  payoutMilli         BigInt                     @default(100000)
  feeBps              Int                        @default(0)
  volumeMilli         BigInt                     @default(0)
  traderCount         Int                        @default(0)
  commentCount        Int                        @default(0)
  version             Int                        @default(0)
  pricingModel        String                     @default("LMSR")
  bookSequence        BigInt                     @default(0)
  commandSequence     BigInt                     @default(0)
  tradeSequence       BigInt                     @default(0)
  engineVersion       Int                        @default(1)
  acceptingOrders     Boolean                    @default(true)
  createdById         String
  eventId             String?
  collateralAccountId String?                    @unique
  createdAt           DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(3)
  createdBy           User                       @relation("MarketCreator", fields: [createdById], references: [id])
  event               MarketEvent?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  collateralAccount   LedgerAccount?             @relation("MarketCollateral", fields: [collateralAccountId], references: [id], onDelete: Restrict)
  solanaBinding       SolanaMarketBinding?
  positions           Position[]
  trades              Trade[]
  comments            Comment[]
  priceHistory        MarketPriceSnapshot[]
  watchlist           WatchlistEntry[]
  suggestions         MarketSuggestion[]
  quotes              TradeQuote[]
  settlements         PositionSettlement[]
  resolutionProposals MarketResolutionProposal[]
  settlementRun       MarketSettlementRun?
  orders              MarketOrder[]
  orderFills          OrderFill[]
  orderEvents         OrderEvent[]
  orderCommands       OrderCommand[]
  orderReservations   OrderReservation[]

  @@index([status, closesAt])
  @@index([eventId, status, closesAt])
  @@index([category, status])
  @@index([featured, status])
  @@index([volumeMilli])
  @@index([executionBackend, status, closesAt])
}

/// Immutable canonical chain identity, not chain state or a financial SQL ledger.
/// Catalog creation must insert the SOLANA Market and its binding in one transaction.
model SolanaMarketBinding {
  id             String   @id @default(cuid())
  marketId       String   @unique
  cluster        String
  genesisHash    String
  programAddress String
  marketAddress  String
  /// Canonical unsigned decimal integer in [0, 18446744073709551615], never a JS number.
  chainMarketId  String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  market         Market   @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@unique([genesisHash, programAddress, marketAddress], map: "SolanaMarketBinding_domain_address_key")
  @@unique([genesisHash, programAddress, chainMarketId], map: "SolanaMarketBinding_domain_id_key")
}

model MarketEvent {
  id              String                      @id @default(cuid())
  slug            String                      @unique
  title           String
  shortTitle      String
  description     String
  category        String
  featured        Boolean                     @default(false)
  color           String                      @default("gold")
  icon            String                      @default("sparkles")
  startsAt        DateTime                    @db.Timestamptz(3)
  endsAt          DateTime                    @db.Timestamptz(3)
  version         Int                         @default(0)
  createdById     String?
  createdAt       DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @db.Timestamptz(3)
  createdBy       User?                       @relation("MarketEventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  creationRequest MarketEventCreationRequest?
  markets         Market[]

  @@index([featured, startsAt])
  @@index([category, startsAt])
  @@index([startsAt, endsAt])
  @@index([createdById, createdAt])
}

model MarketEventCreationRequest {
  id          String      @id @default(cuid())
  actorUserId String
  eventId     String      @unique
  key         String
  requestHash String
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  actor       User        @relation("MarketEventCreationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  event       MarketEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, key])
  @@index([createdAt])
}

model Position {
  id                String   @id @default(cuid())
  userId            String
  marketId          String
  yesShares         Int      @default(0)
  noShares          Int      @default(0)
  netCostMilli      BigInt   @default(0)
  yesCostBasisMilli BigInt   @default(0)
  noCostBasisMilli  BigInt   @default(0)
  realizedPnlMilli  BigInt   @default(0)
  reservedYesShares Int      @default(0)
  reservedNoShares  Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  market            Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId])
  @@index([marketId])
}

model Trade {
  id             String   @id @default(cuid())
  userId         String
  marketId       String
  side           String
  action         String
  quantity       Int
  amountMilli    BigInt
  feeMilli       BigInt   @default(0)
  priceBeforeBps Int
  priceAfterBps  Int
  idempotencyKey String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  market         Market   @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([marketId, createdAt])
  @@index([userId, createdAt])
}

model MarketOrder {
  id                  String            @id @default(cuid())
  userId              String
  marketId            String
  clientOrderId       String
  outcome             String
  action              String
  bookSide            String
  limitPriceMilli     BigInt
  originalQuantity    Int
  remainingQuantity   Int
  filledQuantity      Int               @default(0)
  canceledQuantity    Int               @default(0)
  status              String            @default("OPEN")
  timeInForce         String            @default("GTC")
  postOnly            Boolean           @default(false)
  stpOwnerId          String
  selfTradePrevention String            @default("CANCEL_AGGRESSOR")
  reservedCashMilli   BigInt            @default(0)
  reservedFeeMilli    BigInt            @default(0)
  reservedShares      Int               @default(0)
  cumulativeFeeMilli  BigInt            @default(0)
  acceptedSequence    BigInt
  prioritySequence    BigInt
  terminalSequence    BigInt?
  version             Int               @default(0)
  orderChainId        String
  replacementVersion  Int               @default(0)
  replacedOrderId     String?           @unique
  expiresAt           DateTime?         @db.Timestamptz(3)
  cancelOnPause       Boolean           @default(true)
  reduceOnly          Boolean           @default(false)
  terminalReason      String?
  terminalAt          DateTime?         @db.Timestamptz(3)
  canceledAt          DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  user                User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  market              Market            @relation(fields: [marketId], references: [id], onDelete: Restrict)
  replacedOrder       MarketOrder?      @relation("OrderReplacement", fields: [replacedOrderId], references: [id], onDelete: Restrict)
  replacementOrder    MarketOrder?      @relation("OrderReplacement")
  makerFills          OrderFill[]       @relation("OrderFillMakerOrder")
  takerFills          OrderFill[]       @relation("OrderFillTakerOrder")
  reservation         OrderReservation?
  commands            OrderCommand[]

  @@unique([userId, clientOrderId])
  @@unique([marketId, prioritySequence])
  @@unique([orderChainId, replacementVersion])
  @@index([marketId, bookSide, status, limitPriceMilli, prioritySequence, id])
  @@index([marketId, userId, status, createdAt, id])
  @@index([status, remainingQuantity, expiresAt, id])
}

model OrderFill {
  id                     String       @id @default(cuid())
  marketId               String
  makerOrderId           String
  takerOrderId           String
  canonicalYesPriceMilli BigInt
  quantity               Int
  makerFeeMilli          BigInt       @default(0)
  takerFeeMilli          BigInt       @default(0)
  matchType              String
  commandSequence        BigInt
  tradeSequence          BigInt
  effectIndex            Int
  journalEntryId         String       @unique
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)
  market                 Market       @relation(fields: [marketId], references: [id], onDelete: Restrict)
  makerOrder             MarketOrder  @relation("OrderFillMakerOrder", fields: [makerOrderId], references: [id], onDelete: Restrict)
  takerOrder             MarketOrder  @relation("OrderFillTakerOrder", fields: [takerOrderId], references: [id], onDelete: Restrict)
  journalEntry           JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@unique([marketId, commandSequence, effectIndex])
  @@unique([marketId, tradeSequence])
  @@index([marketId, createdAt, id])
  @@index([makerOrderId, createdAt, id])
  @@index([takerOrderId, createdAt, id])
}

model OrderEvent {
  id              String   @id @default(cuid())
  marketId        String
  userId          String?
  commandSequence BigInt
  eventSequence   BigInt
  effectIndex     Int
  type            String
  visibility      String   @default("PUBLIC")
  payload         String
  schemaVersion   Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  market          Market   @relation(fields: [marketId], references: [id], onDelete: Restrict)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([marketId, commandSequence, effectIndex])
  @@unique([marketId, eventSequence])
  @@index([marketId, eventSequence])
  @@index([userId, eventSequence])
}

model OrderCommand {
  id              String       @id @default(cuid())
  marketId        String
  actorUserId     String
  orderId         String?
  scope           String
  idempotencyKey  String
  requestHash     String
  commandType     String
  commandSequence BigInt
  status          String       @default("PROCESSING")
  responseCode    Int?
  responseBody    String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  completedAt     DateTime?    @db.Timestamptz(3)
  market          Market       @relation(fields: [marketId], references: [id], onDelete: Restrict)
  actor           User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  order           MarketOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, scope, idempotencyKey])
  @@unique([marketId, commandSequence])
  @@index([marketId, commandSequence])
  @@index([orderId])
}

model OrderReservation {
  orderId                String         @id
  userId                 String
  marketId               String
  cashAccountId          String?
  reserveJournalId       String?        @unique
  releaseJournalId       String?        @unique
  reservedPrincipalMilli BigInt         @default(0)
  reservedFeeMilli       BigInt         @default(0)
  reservedYesQuantity    Int            @default(0)
  reservedNoQuantity     Int            @default(0)
  version                Int            @default(0)
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)
  order                  MarketOrder    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user                   User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  market                 Market         @relation(fields: [marketId], references: [id], onDelete: Restrict)
  cashAccount            LedgerAccount? @relation("OrderReservationCash", fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@index([userId, marketId])
  @@index([cashAccountId])
}

model LedgerAccount {
  id                String             @id @default(cuid())
  ownerType         String
  ownerId           String?
  purpose           String
  balanceMilli      BigInt             @default(0)
  allowsNegative    Boolean            @default(false)
  status            String             @default("ACTIVE")
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  postings          LedgerPosting[]
  collateralFor     Market?            @relation("MarketCollateral")
  orderReservations OrderReservation[] @relation("OrderReservationCash")

  @@unique([ownerType, ownerId, purpose])
  @@index([ownerType, ownerId])
}

model JournalEntry {
  id               String          @id @default(cuid())
  type             String
  status           String          @default("POSTED")
  referenceType    String
  referenceId      String
  idempotencyScope String
  idempotencyKey   String
  actorUserId      String?
  metadata         String          @default("{}")
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  postedAt         DateTime?       @default(now()) @db.Timestamptz(3)
  actor            User?           @relation("JournalActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  postings         LedgerPosting[]
  orderFill        OrderFill?

  @@unique([idempotencyScope, idempotencyKey])
  @@index([referenceType, referenceId])
  @@index([actorUserId, createdAt])
}

model LedgerPosting {
  id              String        @id @default(cuid())
  journalEntryId  String
  ledgerAccountId String
  amountMilli     BigInt
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  journalEntry    JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([ledgerAccountId, createdAt])
}

model TradeQuote {
  id             String    @id @default(cuid())
  userId         String
  marketId       String
  side           String
  action         String
  quantity       Int
  amountMilli    BigInt
  feeMilli       BigInt    @default(0)
  marketVersion  Int
  maxDebitMilli  BigInt?
  minCreditMilli BigInt?
  expiresAt      DateTime  @db.Timestamptz(3)
  consumedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  market         Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([marketId, createdAt])
}

model IdempotencyRequest {
  id           String   @id @default(cuid())
  userId       String
  route        String
  key          String
  requestHash  String
  status       String   @default("PROCESSING")
  responseCode Int?
  responseBody String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime @db.Timestamptz(3)

  @@unique([userId, route, key])
  @@index([expiresAt])
}

model PositionSettlement {
  id              String               @id @default(cuid())
  marketId        String
  userId          String
  payoutMilli     BigInt
  journalEntryId  String?              @unique
  settlementRunId String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  market          Market               @relation(fields: [marketId], references: [id], onDelete: Restrict)
  settlementRun   MarketSettlementRun? @relation(fields: [settlementRunId], references: [id], onDelete: Restrict)

  @@unique([marketId, userId])
  @@index([userId, createdAt])
  @@index([settlementRunId, createdAt])
}

model MarketResolutionProposal {
  id                     String               @id @default(cuid())
  marketId               String
  proposerId             String
  approverId             String?
  outcome                String
  reason                 String
  evidence               String
  status                 String               @default("PENDING")
  reviewNote             String               @default("")
  idempotencyKey         String
  requestHash            String
  pendingKey             String?              @unique
  approvalIdempotencyKey String?
  approvalRequestHash    String?
  createdAt              DateTime             @default(now()) @db.Timestamptz(3)
  decidedAt              DateTime?            @db.Timestamptz(3)
  market                 Market               @relation(fields: [marketId], references: [id], onDelete: Restrict)
  proposer               User                 @relation("ResolutionProposer", fields: [proposerId], references: [id], onDelete: Restrict)
  approver               User?                @relation("ResolutionApprover", fields: [approverId], references: [id], onDelete: Restrict)
  settlementRun          MarketSettlementRun?

  @@unique([proposerId, idempotencyKey])
  @@unique([approverId, approvalIdempotencyKey])
  @@index([marketId, status, createdAt])
  @@index([status, createdAt])
}

model MarketSettlementRun {
  id                     String                       @id @default(cuid())
  marketId               String                       @unique
  proposalId             String                       @unique
  outcome                String
  reason                 String
  evidence               String
  approvedById           String
  approvalIdempotencyKey String
  approvalRequestHash    String
  status                 String                       @default("READY")
  cursorPositionId       String?
  totalPositions         Int
  processedCount         Int                          @default(0)
  totalPayoutMilli       BigInt                       @default(0)
  batchCount             Int                          @default(0)
  claimToken             String?
  leaseExpiresAt         DateTime?                    @db.Timestamptz(3)
  lastError              String?
  startedAt              DateTime?                    @db.Timestamptz(3)
  completedAt            DateTime?                    @db.Timestamptz(3)
  createdAt              DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                     @updatedAt @db.Timestamptz(3)
  market                 Market                       @relation(fields: [marketId], references: [id], onDelete: Restrict)
  proposal               MarketResolutionProposal     @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  approvedBy             User                         @relation("SettlementRunApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  settlements            PositionSettlement[]
  attestation            MarketSettlementAttestation?

  @@unique([approvedById, approvalIdempotencyKey])
  @@index([status, leaseExpiresAt, createdAt])
}

/// Immutable intent and finalized receipt for a non-financial Solana
/// commitment to one completed database settlement. No user wallet, token
/// account, or feather balance participates in this record.
model MarketSettlementAttestation {
  id              String              @id @default(cuid())
  settlementRunId String              @unique
  commandId       String              @unique
  digest          String
  marketDigest    String
  signature       String?             @unique
  slot            BigInt?
  attestedAt      DateTime?           @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  settlementRun   MarketSettlementRun @relation(fields: [settlementRunId], references: [id], onDelete: Restrict)
  command         ChainCommand        @relation(fields: [commandId], references: [id], onDelete: Restrict)

  @@index([attestedAt, createdAt])
}

model WorkerState {
  id                   String    @id
  workerName           String    @unique
  instanceId           String
  status               String    @default("STARTING")
  startedAt            DateTime  @db.Timestamptz(3)
  lastHeartbeatAt      DateTime  @db.Timestamptz(3)
  lastCycleStartedAt   DateTime? @db.Timestamptz(3)
  lastCycleSucceededAt DateTime? @db.Timestamptz(3)
  lastCycleFailedAt    DateTime? @db.Timestamptz(3)
  stoppedAt            DateTime? @db.Timestamptz(3)
  consecutiveFailures  Int       @default(0)
  lastError            String?
  cycleCount           BigInt    @default(0)
  successCount         BigInt    @default(0)
  failureCount         BigInt    @default(0)
  closedMarketCount    BigInt    @default(0)
  completedRunCount    BigInt    @default(0)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, lastHeartbeatAt])
}

model MarketPriceSnapshot {
  id                String   @id @default(cuid())
  marketId          String
  yesProbabilityBps Int
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  market            Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, createdAt])
}

model Comment {
  id                   String          @id @default(cuid())
  userId               String
  marketId             String
  parentId             String?
  body                 String
  status               String          @default("VISIBLE")
  positionSideSnapshot String?
  positionQtySnapshot  Int?
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)
  user                 User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  market               Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  parent               Comment?        @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies              Comment[]       @relation("CommentReplies")
  reports              CommentReport[]

  @@index([marketId, createdAt])
  @@index([parentId])
}

model CommentReport {
  id           String    @id @default(cuid())
  commentId    String
  reporterId   String
  reason       String
  details      String    @default("")
  status       String    @default("PENDING")
  resolvedById String?
  resolution   String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt   DateTime? @db.Timestamptz(3)
  comment      Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter     User      @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy   User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([commentId, reporterId])
  @@index([status, createdAt])
}

model WatchlistEntry {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId])
}

model MarketSuggestion {
  id           String    @id @default(cuid())
  userId       String
  title        String
  description  String
  category     String
  status       String    @default("PENDING")
  marketId     String?
  reviewedById String?
  reviewNote   String    @default("")
  reviewedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  user         User      @relation("SuggestionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?     @relation("SuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  market       Market?   @relation(fields: [marketId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model RateLimitBucket {
  key       String   @id
  points    Int      @default(0)
  resetAt   DateTime @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([resetAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  metadata    String   @default("{}")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  actor       User     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt, id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model RegistrationInvite {
  id          String                    @id @default(cuid())
  codeHash    String                    @unique
  issuanceKey String?                   @unique
  requestHash String?
  label       String
  status      String                    @default("ACTIVE")
  maxUses     Int                       @default(1)
  useCount    Int                       @default(0)
  expiresAt   DateTime?                 @db.Timestamptz(3)
  createdById String
  createdAt   DateTime                  @default(now()) @db.Timestamptz(3)
  createdBy   User                      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  claims      RegistrationInviteClaim[]

  @@index([status, expiresAt])
}

model RegistrationInviteClaim {
  id        String             @id @default(cuid())
  inviteId  String
  userId    String             @unique
  claimedAt DateTime           @default(now()) @db.Timestamptz(3)
  invite    RegistrationInvite @relation(fields: [inviteId], references: [id], onDelete: Restrict)
  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([inviteId, userId])
  @@index([inviteId, claimedAt])
}

model RegistrationDevice {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}
