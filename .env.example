ADMIN_EMAIL=""
ADMIN_PASSWORD=""
GOOSEY_ADMIN_EMAIL=""
GOOSEY_ADMIN_USERNAME=""
GOOSEY_ADMIN_DISPLAY_NAME=""
GOOSEY_ADMIN_PASSWORD=""
NEXT_PUBLIC_APP_URL="http://localhost:8080"
APP_URL="http://localhost:8080"
